\newlabel{eq:tensor_power}{{2.2}{6}{Observables overview}{equation.2.0.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces \small  Theoretical calculations for the nuclear transparency $T$ (left) and tensor analyzing power $A_{zz}$ (right) for the process $pd\rightarrow ppn$. Both observables are plotted as functions of the transverse momentum of the spectator neutron ($p_{st}$). The calculations are performed in the framework of the generalized eikonal approximation (GEA) supplemented by the quantum diffusion model of CT~\cite  {Frankfurt:1996uz,PhysRevC.107.014605,Larionov:2025equ,Farrar:1988me}. With the color transparency effects included, the presented variables are expected to be within the gray bands, respectively. Both figures are taken from Ref.~\cite  {Larionov:2025equ}, where more details on the performed calculations can be found.\relax }}{6}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:T_larionov}{{2.1}{6}{\small Theoretical calculations for the nuclear transparency $T$ (left) and tensor analyzing power $A_{zz}$ (right) for the process $pd\rightarrow ppn$. Both observables are plotted as functions of the transverse momentum of the spectator neutron ($p_{st}$). The calculations are performed in the framework of the generalized eikonal approximation (GEA) supplemented by the quantum diffusion model of CT~\cite {Frankfurt:1996uz,PhysRevC.107.014605,Larionov:2025equ,Farrar:1988me}. With the color transparency effects included, the presented variables are expected to be within the gray bands, respectively. Both figures are taken from Ref.~\cite {Larionov:2025equ}, where more details on the performed calculations can be found.\relax }{figure.caption.2}{}}
\citation{Frankfurt:1996uz,PhysRevC.107.014605,Larionov:2025equ,Farrar:1988me}
