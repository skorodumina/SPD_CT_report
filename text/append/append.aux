\@writefile{lof}{\contentsline {figure}{\numberline {A.1}{\ignorespaces \small  The position dependent factor $\mathcal  F_{\textrm  {CT}}$, through which CT effects are introduced into the parameterization of the $M_{\textrm  {soft}}^{\textrm  {el}}$ amplitude in the QDM (see Eqs.~\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:soft_par}\unskip \@@italiccorr )}},~\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:soft_par2}\unskip \@@italiccorr )}},~and~\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:soft_par3}\unskip \@@italiccorr )}}). The factor is plotted as a function of the variable $l$ defined by Eq.~\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:l_distance}\unskip \@@italiccorr )}}. The coherence length $l_{\textrm  {c}}$ is calculated according to Eq.~\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:l_coh}\unskip \@@italiccorr )}}. The part of the graph shown by the dashed line (for $l<l_{\textrm  {c}}$) corresponds to the color transparency regime, where a quark configuration interacts with the nuclear medium with the reduced cross section. See text for more details. \relax }}{35}{figure.caption.12}\protected@file@percent }
\newlabel{fig:l_coh}{{A.1}{35}{\small The position dependent factor $\mathcal F_{\textrm {CT}}$, through which CT effects are introduced into the parameterization of the $M_{\textrm {soft}}^{\textrm {el}}$ amplitude in the QDM (see Eqs.~\eqref {eq:soft_par},~\eqref {eq:soft_par2},~and~\eqref {eq:soft_par3}). The factor is plotted as a function of the variable $l$ defined by Eq.~\eqref {eq:l_distance}. The coherence length $l_{\textrm {c}}$ is calculated according to Eq.~\eqref {eq:l_coh}. The part of the graph shown by the dashed line (for $l<l_{\textrm {c}}$) corresponds to the color transparency regime, where a quark configuration interacts with the nuclear medium with the reduced cross section. See text for more details. \relax }{figure.caption.12}{}}
