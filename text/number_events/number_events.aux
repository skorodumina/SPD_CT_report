\newlabel{eq:n_events}{{4.1}{14}{Event rate estimation}{equation.4.0.1}{}}
\newlabel{tab:cr_sect_est}{{4.1}{15}{\small Theoretical predictions for the cross section values at four different points in $p_{st}$. ``GEA" stands for the calculations performed within the generalized eikonal approximation, while ``CT3" corresponds to the case when contributions from the color transparency effects were included in the framework of the quantum diﬀusion model with the free parameter $\Delta M^{2}=3$~GeV$^{2}$ (see Refs.~\cite {Frankfurt:1996uz,PhysRevC.107.014605,Larionov:2025equ,Farrar:1988me} for details). The calculations were performed for $\sqrt {s}=13$~GeV and the following values of the remaining kinematic variables, $\alpha _{s} = 1$, $t=-6.8$~GeV$^{2}$ (which corresponds to $\theta _{\textrm {c.m.}}=49^{o}$), and $\phi =\pi $. \relax }{table.4.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.1}{\ignorespaces \small  Theoretical predictions for the cross section values at four different points in $p_{st}$. ``GEA" stands for the calculations performed within the generalized eikonal approximation, while ``CT3" corresponds to the case when contributions from the color transparency effects were included in the framework of the quantum diﬀusion model with the free parameter $\Delta M^{2}=3$~GeV$^{2}$ (see Refs.~\cite  {Frankfurt:1996uz,PhysRevC.107.014605,Larionov:2025equ,Farrar:1988me} for details). The calculations were performed for $\sqrt  {s}=13$~GeV and the following values of the remaining kinematic variables, $\alpha _{s} = 1$, $t=-6.8$~GeV$^{2}$ (which corresponds to $\theta _{\textrm  {c.m.}}=49^{o}$), and $\phi =\pi $. \relax }}{15}{table.4.1}\protected@file@percent }
\newlabel{tab:event_per_year}{{4.2}{15}{\small Estimated number of events per year for four large bins in $p_{st}$. The estimation accounts for two theoretical cross section approximations (``GEA" and ``CT3") described in the text and also in the context of Tab.~\ref {tab:cr_sect_est}. The estimation was performed based on the Monte Carlo simulation for $\sqrt {s}=13$~GeV, $\alpha _{s}=1$ and $t=-6.8$~GeV$^{2}$ (which corresponds to $\theta _{\textrm {c.m.}}=49^{o}$), using the following bin widths for the kinematic variables, $\Delta \alpha _{s} = 0.25$, $\Delta t = 2.5$~GeV$^{2}$, $\Delta \phi = 2\pi $, and $\Delta p_{st} = 0.1$~GeV/c, experiment duration $T=10^{7}$~s (1 year), and the luminosity value $\mathcal {L} = 10^{30}$~cm$^{-2}$s$^{-1}$. Numbers highlighted in red correspond to the $p_{st}=0.2~\textrm {GeV/c}$, where the largest relative difference between the two model curves is expected. \relax }{table.4.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.2}{\ignorespaces \small  Estimated number of events per year for four large bins in $p_{st}$. The estimation accounts for two theoretical cross section approximations (``GEA" and ``CT3") described in the text and also in the context of Tab.~\ref  {tab:cr_sect_est}. The estimation was performed based on the Monte Carlo simulation for $\sqrt  {s}=13$~GeV, $\alpha _{s}=1$ and $t=-6.8$~GeV$^{2}$ (which corresponds to $\theta _{\textrm  {c.m.}}=49^{o}$), using the following bin widths for the kinematic variables, $\Delta \alpha _{s} = 0.25$, $\Delta t = 2.5$~GeV$^{2}$, $\Delta \phi = 2\pi $, and $\Delta p_{st} = 0.1$~GeV/c, experiment duration $T=10^{7}$~s (1 year), and the luminosity value $\mathcal  {L} = 10^{30}$~cm$^{-2}$s$^{-1}$. Numbers highlighted in red correspond to the $p_{st}=0.2~\textrm  {GeV/c}$, where the largest relative difference between the two model curves is expected. \relax }}{15}{table.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces \small  Estimated number of events per year for four large bins in $p_{st}$. The estimation accounts for two theoretical cross section approximations: ``GEA" (blue histogram) and ``CT3" (black histogram) described in the text. The estimation was performed based on the Monte Carlo simulation for $\sqrt  {s}=13$~GeV, $\alpha _{s}=1$ and $t=-6.8$~GeV$^{2}$ (which corresponds to $\theta _{\textrm  {c.m.}}=49^{o}$), using the following bin widths for the kinematic variables, $\Delta \alpha _{s} = 0.25$, $\Delta t = 2.5$~GeV$^{2}$, $\Delta \phi = 2\pi $, and $\Delta p_{st} = 0.1$~GeV/c, experiment duration $T=10^{7}$~s (1 year), and the luminosity value $\mathcal  {L} = 10^{30}$cm$^{-2}$s$^{-1}$. \relax }}{16}{figure.caption.6}\protected@file@percent }
\newlabel{fig:rate_MC}{{4.2}{16}{\small Estimated number of events per year for four large bins in $p_{st}$. The estimation accounts for two theoretical cross section approximations: ``GEA" (blue histogram) and ``CT3" (black histogram) described in the text. The estimation was performed based on the Monte Carlo simulation for $\sqrt {s}=13$~GeV, $\alpha _{s}=1$ and $t=-6.8$~GeV$^{2}$ (which corresponds to $\theta _{\textrm {c.m.}}=49^{o}$), using the following bin widths for the kinematic variables, $\Delta \alpha _{s} = 0.25$, $\Delta t = 2.5$~GeV$^{2}$, $\Delta \phi = 2\pi $, and $\Delta p_{st} = 0.1$~GeV/c, experiment duration $T=10^{7}$~s (1 year), and the luminosity value $\mathcal {L} = 10^{30}$cm$^{-2}$s$^{-1}$. \relax }{figure.caption.6}{}}
