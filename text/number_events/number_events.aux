\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces \small  Theoretical predictions for the differential cross section of the $pd\rightarrow ppn$ process as a function of the transverse momentum of the spectator neutron ($p_{st}$)~\cite  {Frankfurt:1996uz,PhysRevC.107.014605,Larionov:2025equ,Farrar:1988me}. The solid magenta curve shows the impulse approximation (IA), while the solid blue curve corresponds to the full GEA calculation (both ``hard" and ``soft" parts). For the black curves, CT effects were included according to the quantum diffusion model of CT with different values of $\Delta M^{2}$ (specified in the plot). The calculations were performed for the following values of the remaining kinematic variables, $\alpha _{s} = 1$, $t=-6.8$~GeV$^{2}$ (which corresponds to $\theta _{\textrm  {c.m.}}=49^{o}$), and $\phi =\pi $. \relax }}{13}{figure.caption.5}\protected@file@percent }
\newlabel{fig:model}{{4.1}{13}{\small Theoretical predictions for the differential cross section of the $pd\rightarrow ppn$ process as a function of the transverse momentum of the spectator neutron ($p_{st}$)~\cite {Frankfurt:1996uz,PhysRevC.107.014605,Larionov:2025equ,Farrar:1988me}. The solid magenta curve shows the impulse approximation (IA), while the solid blue curve corresponds to the full GEA calculation (both ``hard" and ``soft" parts). For the black curves, CT effects were included according to the quantum diffusion model of CT with different values of $\Delta M^{2}$ (specified in the plot). The calculations were performed for the following values of the remaining kinematic variables, $\alpha _{s} = 1$, $t=-6.8$~GeV$^{2}$ (which corresponds to $\theta _{\textrm {c.m.}}=49^{o}$), and $\phi =\pi $. \relax }{figure.caption.5}{}}
