\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces \small  Impulse approximation (IA) diagrams for the process $pd\rightarrow ppn$ (left) and the process $dd\rightarrow ppnn$ (right). For both diagrams, the following notations are used for the particles' four-momenta: $p_{d}$ and $p_{d_1}$ correspond to the deuterons in the initial state, $p_{1}$ -- the incoming/initial proton, $p_{2}$ -- the intermediate/reaction proton (not shown in the right diagram), $p_{s}$ and $p_{s_1}$ -- the final state neutrons, and $p_{3}$ and $p_{4}$ -- the final state protons.\relax }}{8}{figure.caption.3}\protected@file@percent }
\newlabel{fig:diagram}{{3.1}{8}{\small Impulse approximation (IA) diagrams for the process $pd\rightarrow ppn$ (left) and the process $dd\rightarrow ppnn$ (right). For both diagrams, the following notations are used for the particles' four-momenta: $p_{d}$ and $p_{d_1}$ correspond to the deuterons in the initial state, $p_{1}$ -- the incoming/initial proton, $p_{2}$ -- the intermediate/reaction proton (not shown in the right diagram), $p_{s}$ and $p_{s_1}$ -- the final state neutrons, and $p_{3}$ and $p_{4}$ -- the final state protons.\relax }{figure.caption.3}{}}
\citation{PhysRevC.107.014605}
