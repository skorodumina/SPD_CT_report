\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces \small  Distributions of the momentum magnitude (top row) and the polar angle (bottom row) for the two final protons. The left plots correspond to the proton $p_{3}$ and the right plots -- to the proton $p_{4}$ (as denoted in Fig.~\ref  {fig:diagram}). Thick blue histograms correspond to the unweighted distributions and thin background histograms show the distributions weighted with the ``GEA" cross section approximation (see Ch.~\ref  {chapter_rate} for details). The simulation was performed in the following kinematic area, $\sqrt  {s}=13$~GeV, $\alpha _{s} =1$ with $\Delta \alpha _{s} = 0.25$, $t=-6.8$~GeV$^2$ (which corresponds to $\theta _{\textrm  {c.m.}}=49^{o}$) with $\Delta t = 2.5$~GeV$^{2}$, $\Delta \phi = 2\pi $, and $0.1$~GeV/c~$<p_{st}<0.5$~GeV/c. All histograms are normalized to their maxima.\relax }}{20}{figure.caption.7}\protected@file@percent }
\newlabel{fig:gen_protons}{{5.1}{20}{\small Distributions of the momentum magnitude (top row) and the polar angle (bottom row) for the two final protons. The left plots correspond to the proton $p_{3}$ and the right plots -- to the proton $p_{4}$ (as denoted in Fig.~\ref {fig:diagram}). Thick blue histograms correspond to the unweighted distributions and thin background histograms show the distributions weighted with the ``GEA" cross section approximation (see Ch.~\ref {chapter_rate} for details). The simulation was performed in the following kinematic area, $\sqrt {s}=13$~GeV, $\alpha _{s} =1$ with $\Delta \alpha _{s} = 0.25$, $t=-6.8$~GeV$^2$ (which corresponds to $\theta _{\textrm {c.m.}}=49^{o}$) with $\Delta t = 2.5$~GeV$^{2}$, $\Delta \phi = 2\pi $, and $0.1$~GeV/c~$<p_{st}<0.5$~GeV/c. All histograms are normalized to their maxima.\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces \small  Distributions of the momentum magnitude (top row) and the polar angle (bottom row) for the two final neutrons. The left plots correspond to the neutron $p_{s}$ and the right plots -- to the neutron $p_{s1}$ (as denoted in Fig.~\ref  {fig:diagram}). Thick blue histograms correspond to the unweighted distributions and thin background histograms show the distributions weighted with the ``GEA" cross section approximation (see Ch.~\ref  {chapter_rate} for details). The simulation was performed in the following kinematic area, $\sqrt  {s}=13$~GeV, $\alpha _{s} =1$ with $\Delta \alpha _{s} = 0.25$, $t=-6.8$~GeV$^2$ (which corresponds to $\theta _{\textrm  {c.m.}}=49^{o}$) with $\Delta t = 2.5$~GeV$^{2}$, $\Delta \phi = 2\pi $, and $0.1$~GeV/c~$<p_{st}<0.5$~GeV/c. All histograms are normalized to their maxima.\relax }}{21}{figure.caption.8}\protected@file@percent }
\newlabel{fig:gen_neutrons}{{5.2}{21}{\small Distributions of the momentum magnitude (top row) and the polar angle (bottom row) for the two final neutrons. The left plots correspond to the neutron $p_{s}$ and the right plots -- to the neutron $p_{s1}$ (as denoted in Fig.~\ref {fig:diagram}). Thick blue histograms correspond to the unweighted distributions and thin background histograms show the distributions weighted with the ``GEA" cross section approximation (see Ch.~\ref {chapter_rate} for details). The simulation was performed in the following kinematic area, $\sqrt {s}=13$~GeV, $\alpha _{s} =1$ with $\Delta \alpha _{s} = 0.25$, $t=-6.8$~GeV$^2$ (which corresponds to $\theta _{\textrm {c.m.}}=49^{o}$) with $\Delta t = 2.5$~GeV$^{2}$, $\Delta \phi = 2\pi $, and $0.1$~GeV/c~$<p_{st}<0.5$~GeV/c. All histograms are normalized to their maxima.\relax }{figure.caption.8}{}}
